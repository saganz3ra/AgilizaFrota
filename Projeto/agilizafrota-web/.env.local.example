# ==========================================================================
# Agiliza Frota - Web (Central) | Exemplo de variaveis de ambiente
# Copie para ".env.local" e preencha. Variaveis NEXT_PUBLIC_* vao ao browser.
# Use o MESMO projeto Firebase configurado no backend.
# ==========================================================================

# URL base da API (backend). Inclua o prefixo /api.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Firebase (client) - Console do Firebase > Configuracoes do Projeto ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=SEU_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=SEU_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=SEU_PROJECT.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
