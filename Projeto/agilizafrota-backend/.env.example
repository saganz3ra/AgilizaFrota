# ==========================================================================
# Agiliza Frota - Backend | Exemplo de variaveis de ambiente
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NUNCA deve ser versionado (ver .gitignore).
# ==========================================================================

# Ambiente de execucao: development | production | test
NODE_ENV=development

# Porta da API
PORT=3000

# --- Banco de dados PostgreSQL ------------------------------------------
DATABASE_URL=postgresql://agiliza:agiliza@localhost:5432/agilizafrota

# --- CORS ----------------------------------------------------------------
# Origens permitidas separadas por virgula. Use "*" apenas em desenvolvimento.
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# --- Firebase Admin ------------------------------------------------------
# Caminho para a chave de servico baixada do console do Firebase.
FIREBASE_KEY_PATH=./firebase-key.json

# --- Bootstrap do primeiro usuario "central" ----------------------------
BOOTSTRAP_SECRET=troque-por-um-segredo-forte

# --- Integracao com sistema externo (abertura de chamados) --------------
# Enviada no cabecalho "X-API-Key". Deixe vazio para desabilitar.
EXTERNAL_API_KEY=troque-por-uma-chave-forte

# --- Rate limiting -------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=50

# --- Notificacao de chegada (RF15) --------------------------------------
# Raio (em metros) para considerar que o veiculo chegou a unidade de destino.
NOTIFICACAO_RAIO_CHEGADA_M=300

# --- Rotas e tempo de chegada (RF16/RF17) -------------------------------
# Chave da API do Google Maps (Directions). Se vazio, o sistema usa a
# ESTIMATIVA LOCAL (distancia em linha reta x fator / velocidade media).
GOOGLE_MAPS_API_KEY=
# Fator de sinuosidade da rota real em relacao a linha reta.
ROTA_FATOR_SINUOSIDADE=1.3
# Tempo maximo de espera pelo provedor de mapas (ms) antes de cair no fallback.
MAPAS_TIMEOUT_MS=4000
# Cache das consultas de rota (ms).
MAPAS_CACHE_TTL_MS=60000

# --- Pool e timeouts do banco (RNF07/RNF08) -----------------------------
# Conexoes simultaneas por instancia da API (varias instancias => some).
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
# Aborta consultas que passem deste tempo (evita travamento em cascata).
PG_STATEMENT_TIMEOUT_MS=15000

# --- Evidencias fotograficas (RF03) -------------------------------------
# Pasta onde as fotos sao gravadas. Padrao: ./uploads
UPLOAD_DIR=
# Tamanho maximo aceito por arquivo, em MB.
UPLOAD_MAX_MB=8
# URL publica da API. Deixe vazio em desenvolvimento: o servidor usa o
# mesmo host da requisicao, o que funciona para localhost, emulador
# (10.0.2.2) e celular na rede local ao mesmo tempo.
APP_URL=
